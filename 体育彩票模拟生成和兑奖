#include<stdio.h>
#include<stdlib.h>
#include<time.h>
#define N 7
typedef struct Node{
	int data[7];
	struct Node *next;
}Node;
typedef struct BSTNode {
    int data;
    struct BSTNode *l;  
    struct BSTNode *r;  
} BSTNode;
void initNode(Node**head)	//无头结点
{
	*head=NULL;
}
Node *tiqunum(Node* List,int *count)
{
	int num,c;
	int n;
	printf("请输入彩票生成的最大范围：");
	scanf("%d",&n);
	c = rand() % n +1;   
	*count=c;
	printf("本次生成彩票数量：%d\n",c);
	for(int i=0;i<c;i++)
	{
		Node *p=(Node*)malloc(sizeof(Node));
		for(int j=0;j<N;j++)
		{
			int f=1;
			num = rand() % 36 + 1;	
			for(int k=0;k<j;k++)
			{
				if(num==p->data[k])
				{
					f=0;
					j--;
					break;
				}
			}	
			if(f==1)
			{
				p->data[j]=num;
			}
			
		}
		p->next=List;
		List=p;
	}
	return List;
}
void printflist(Node *list,int count)		//打印链表验证
{
	Node *Lt=list;
	int i,k;
	for(i=0;i<count;i++)
	{
		for(k=0;k<N;k++)
		{
			printf("%d ",Lt->data[k]);
		}
		printf("\n");
		Lt=Lt->next;
	}
}
void paixuArr(int right[])	//从小到大
{
	int i,j;
	for(i=0;i<N;i++)
	{
		for(j=i;j<N;j++)
		{
			if(right[i]>right[j])
			{
				int t=right[i];
				right[i]=right[j];
				right[j]=t;
			}
		}
	}
}

//查找算法
//顺序查找
void shunxu(Node *list,int right[],int c)
{
	int i,j,f,n=0;
	Node *Lt=list;
	for(i=0;i<c;i++)
	{
		f=0;
		for(j=0;j<N;j++)
		{
			for(int k=0;k<N;k++)
			{
				if(right[j]==Lt->data[k])
				{
					f++;
					break;
				}
			}
		}
		if(f==N)
			n++;		
		Lt=Lt->next;
	}
	printf("\n顺序查找中奖个数为：%d\n",n);
}
//折半查找
void zheban(Node *list,int right[],int c)
{
	int i,n=0,j,f;
	int low,high,mid;
	Node *Lt=list;

	for(i=0;i<c;i++)
	{
		f=0;
		for(j=0;j<N;j++)
		{
			low=0;high=N-1;
			while(low<=high)	//折半查找
			{
				mid=(low+high)/2;
				if(Lt->data[j]<right[mid])
					high=mid-1;
				else if(Lt->data[j]>right[mid])
					low=mid+1;
				else 
				{
					f++;
					break;
				}
			}	
		}
		if(f==N)
			n++;
		Lt=Lt->next;		
	}
	printf("折半查找中奖个数为：%d\n",n);
}
//哈希查找
void Haxi(Node *list,int right[],int c)
{
	int a[37]={0};
	int i,j,f,n=0;
	Node *Lt=list;
	for(i=0;i<N;i++)
	{
		a[right[i]%37]++;
	}
	for(i=0;i<c;i++)
	{
		f=0;
		for(j=0;j<N;j++)
		{
			if(a[Lt->data[j]]!=0)
			{
				f++;	
			}
		}
		if(f==N)
			n++;
		Lt=Lt->next;
	}
	printf("哈希查找中奖个数为：%d\n",n);
}
//二叉树查找
BSTNode* BST_Insert(BSTNode *root,int key) 
{
    if (root==NULL) 
	{
        BSTNode *p=(BSTNode*)malloc(sizeof(BSTNode));
        p->data=key;
        p->l=p->r=NULL;
        return p;
    }
    if (key<root->data)
        root->l=BST_Insert(root->l,key);  
    else if (key>root->data)
        root->r=BST_Insert(root->r,key);  
    return root;
}

int BST_Search(BSTNode *root, int key)
{
    if(root==NULL)	return 0;
    if(root->data==key)	return 1;
    if(key<root->data)
        return BST_Search(root->l, key);  
    else
        return BST_Search(root->r, key);  
}

void BST_Free(BSTNode *root) 
{
    if(root==NULL)	return;
    BST_Free(root->l);
    BST_Free(root->r);
    free(root);
}

void BST(Node *list,int right[],int c) 
{
    int i,j,f,n=0;
    Node *Lt=list;
    BSTNode *root;
    for (i=0;i<c;i++) 
	{
        root=NULL;
        for(j=0;j<N;j++) 
		{
            root=BST_Insert(root,Lt->data[j]);
        }
        f=0;
        for(j=0;j<N;j++) 
		{
            if(BST_Search(root,right[j])) 
			{
                f++;
            }
        }
        if(f==N) 
			n++;
        BST_Free(root);  
        Lt=Lt->next;
    }
    printf("二叉排序树查找中奖个数为：%d\n", n);
}
int main()
{
	srand((unsigned)time(NULL));
	Node *list;
	int count;
	initNode(&list);
	list=tiqunum(list,&count);
	printf("\n打印生成的号码:\n");
	printflist(list,count);		//打印链表验证
	printf("\n请输入中奖号码\n");
	int right[N];
	for(int i=0;i<N;i++)
		scanf("%d",&right[i]);
	shunxu(list,right,count);
	BST(list, right, count);
	Haxi(list, right, count);
	
	paixuArr(right);
	zheban(list,right,count);
	return 0;
}
